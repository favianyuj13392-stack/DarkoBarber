# Supabase PostgreSQL Connection URL (Pooler mode recommended for IPv4)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Fastify JWT Secret
JWT_SECRET="generate-a-strong-random-32-char-string"

# Fastify Server Port
PORT=4000

# Google OAuth 2.0 Client ID (Required to strictly validate audience on Google auth tokens)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"

# Cloudflare R2 Credentials
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="fadebucket"

# Resend Transactional Email Service
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Fade <fade@mail.darkosync.com>"
RESEND_REPLY_TO="soporte@darkosync.com"
APP_PUBLIC_URL="https://fade.darkosync.com"

# Rewards program
REWARD_ACQUISITION_GOAL=15
REWARD_MAX_FREE_MONTHS=3
REWARD_QUALIFY_MIN_DAYS_AFTER_SIGNUP=1
ADMIN_API_KEY=change_me
APP_PUBLIC_URL=https://your-domain.example
EMAIL_VERIFICATION_TTL_HOURS=24
EMAIL_VERIFICATION_MAX_PER_DAY=3
CHAIR_BIND_MAX_PER_CLIENT_PER_MIN=10
CHAIR_BIND_MAX_PER_IP_PER_MIN=30

# Cut quota: free cancellations per month, as a percent of the plan limit
CUTS_CANCEL_ALLOWANCE_PCT=5

BOOKING_MAX_ADVANCE_DAYS=30
BOOKING_CANCEL_MIN_HOURS=2
BOOKING_MAX_ACTIVE_PER_CLIENT=3