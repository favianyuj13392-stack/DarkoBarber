datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

enum Plan {
  AUTONOMO
  BARBERIA_BASE
  ALTO_FLUJO
}

enum CutStatus {
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum PresenceStatus {
  GREEN
  RED
  YELLOW
  GRAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum AcquisitionStatus {
  PENDING
  QUALIFIED
  REVOKED
}

enum ClientActivityType {
  HISTORY_VIEW
  CONSENT_UPDATE
  BOOKING_CREATED
  CUT_CONFIRMED
  APP_SESSION
}

enum RewardType {
  ACQUISITION_BONUS
}

enum RewardClaimStatus {
  PENDING
  APPROVED
  REJECTED
  REVERSED
}

model Shop {
  id          String   @id @default(uuid())
  name        String
  address     String?
  zone        String?
  latitude    Float?
  longitude   Float?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  barbers     Barber[]

  @@index([isActive])
}

model Barber {
  id            String    @id @default(uuid())
  email         String?   @unique
  phone         String?   @unique
  displayName   String
  pinHash       String?
  passwordHash  String?
  // Bumped on every password change; JWTs carry it and stop working when it differs.
  tokenVersion  Int       @default(0)
  googleId      String?   @unique
  avatarUrl     String?
  bio           String?
  linkedin      String?
  instagram     String?
  tiktok        String?
  specialties   String[]        @default([])
  plan          Plan            @default(AUTONOMO)
  shopId        String?
  shop          Shop?           @relation(fields: [shopId], references: [id], onDelete: SetNull)
  deviceId      String?
  isActive      Boolean         @default(true)
  cuts          Cut[]
  services      BarberService[]
  followers     BarberFollower[]
  freeMonthsEarned Int             @default(0)
  acquiredClients Client[]        @relation("BarberAcquisitions")
  rewardClaims  RewardClaim[]
  acceptsBookings Boolean         @default(true)
  bookingNoticeMin Int            @default(15)
  workingHours  Json?
  bookings      Booking[]
  presence      Presence?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([email])
  @@index([phone])
  @@index([shopId])
  @@index([isActive])
}

model Presence {
  barberId      String         @id
  barber        Barber         @relation(fields: [barberId], references: [id], onDelete: Cascade)
  status        PresenceStatus @default(GRAY)
  waitingCount  Int            @default(0) // 0: Nadie, 1: 1 a 2, 2: 3 o más
  activeCutId   String?
  expiresAt     DateTime?      // Timeout for phantom cut auto-cancellation (startedAt + 50 min)
  lastHeartbeat DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

model Client {
  id           String          @id @default(uuid())
  email        String?         @unique
  passwordHash String?
  // Bumped on every password change; JWTs carry it and stop working when it differs.
  tokenVersion Int             @default(0)
  googleId     String?         @unique
  displayName  String?
  avatarUrl    String?
  phone        String?         @unique
  firstScanBarberId String?
  firstScanBarber   Barber?         @relation("BarberAcquisitions", fields: [firstScanBarberId], references: [id], onDelete: SetNull)
  firstScanAt       DateTime?
  // Rewards program. NULL = not part of any acquisition (all pre-existing rows stay NULL,
  // so they never count toward a barber's reward). Set to PENDING only when a client is
  // newly captured by a barber after this feature ships.
  acquisitionStatus AcquisitionStatus?
  qualifiedAt       DateTime?
  emailVerifiedAt   DateTime?
  signupIp          String?
  signupDeviceId    String?
  profiles     ClientProfile[]
  following    BarberFollower[]
  bookings     Booking[]
  activities   ClientActivity[]
  emailVerificationTokens EmailVerificationToken[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([email])
  @@index([phone])
  @@index([firstScanBarberId])
  @@index([firstScanBarberId, acquisitionStatus])
}

model ClientProfile {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  cuts        Cut[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model Cut {
  id                String        @id @default(uuid())
  clientRequestId   String        @unique
  barberId          String
  barber            Barber        @relation(fields: [barberId], references: [id])
  clientProfileId   String
  clientProfile     ClientProfile @relation(fields: [clientProfileId], references: [id])
  status            CutStatus     @default(IN_PROGRESS)
  chips             Json?
  startedAt         DateTime      @default(now())
  finishedAt        DateTime?
  rapidClosure      Boolean       @default(false)
  photos            CutPhoto[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([barberId, status])
  @@index([clientProfileId])
  @@index([startedAt])
}

model CutPhoto {
  id          String   @id @default(uuid())
  cutId       String
  cut         Cut      @relation(fields: [cutId], references: [id], onDelete: Cascade)
  r2Key       String
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([cutId])
  @@index([isPublic])
}

model BarberService {
  id          String   @id @default(uuid())
  barberId    String
  barber      Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  name        String
  priceBs     Float
  durationMin Int      @default(30)
  category    String?  @default("corte")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([barberId])
  @@index([isActive])
}

model BarberFollower {
  id        String   @id @default(uuid())
  barberId  String
  barber    Barber   @relation(fields: [barberId], references: [id], onDelete: Cascade)
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([barberId, clientId])
  @@index([barberId])
  @@index([clientId])
}

model Booking {
  id             String        @id @default(uuid())
  barberId       String
  barber         Barber        @relation(fields: [barberId], references: [id], onDelete: Cascade)
  clientId       String?
  client         Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName     String
  clientPhone    String
  serviceName    String
  servicePriceBs Float
  durationMin    Int           @default(30)
  date           String
  time           String
  scheduledAt    DateTime?
  status         BookingStatus @default(PENDING)
  notes          String?
  cancelReason   String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([barberId, status])
  @@index([barberId, date])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  email     String
  // SHA-256 hex digest of the emailed token. The raw token is never stored.
  tokenHash String    @unique
  role      String    @default("barbero")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email])
}

model ClientActivity {
  id        String             @id @default(uuid())
  clientId  String
  client    Client             @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      ClientActivityType
  createdAt DateTime           @default(now())

  @@index([clientId, createdAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
}

model RewardClaim {
  id                    String            @id @default(uuid())
  barberId              String
  barber                Barber            @relation(fields: [barberId], references: [id], onDelete: Cascade)
  type                  RewardType
  goalKey               String
  status                RewardClaimStatus @default(PENDING)
  qualifiedCountAtClaim Int
  note                  String?
  reviewedAt            DateTime?
  reviewedBy            String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([barberId, type, goalKey])
}
