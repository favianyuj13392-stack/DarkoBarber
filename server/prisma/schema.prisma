datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Plan {
  AUTONOMO
  BARBERIA_BASE
  ALTO_FLUJO
}

enum CutStatus {
  IN_PROGRESS
  FINISHED
  CANCELLED
}

enum PresenceStatus {
  GREEN
  RED
  YELLOW
  GRAY
}

model Shop {
  id          String   @id @default(uuid())
  name        String
  address     String?
  zone        String?
  latitude    Float?
  longitude   Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  barbers     Barber[]
}

model Barber {
  id            String    @id @default(uuid())
  email         String?   @unique
  phone         String?   @unique
  displayName   String
  pinHash       String?
  passwordHash  String?
  googleId      String?   @unique
  avatarUrl     String?
  bio           String?
  linkedin      String?
  instagram     String?
  specialties   String[]  @default([])
  plan          Plan      @default(AUTONOMO)
  shopId        String?
  shop          Shop?     @relation(fields: [shopId], references: [id])
  deviceId      String?
  cuts          Cut[]
  presence      Presence?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([phone])
}

model Presence {
  barberId      String         @id
  barber        Barber         @relation(fields: [barberId], references: [id], onDelete: Cascade)
  status        PresenceStatus @default(GRAY)
  waitingCount  Int            @default(0) // 0: Nadie, 1: 1 a 2, 2: 3 o más
  activeCutId   String?
  expiresAt     DateTime?      // Timeout for phantom cut auto-cancellation (startedAt + 50 min)
  lastHeartbeat DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([status])
}

model Client {
  id           String          @id @default(uuid())
  email        String?         @unique
  passwordHash String?
  googleId     String?         @unique
  displayName  String?
  avatarUrl    String?
  phone        String?         @unique
  profiles     ClientProfile[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([email])
  @@index([phone])
}

model ClientProfile {
  id          String   @id @default(uuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name        String
  cuts        Cut[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
}

model Cut {
  id                String        @id @default(uuid())
  clientRequestId   String        @unique
  barberId          String
  barber            Barber        @relation(fields: [barberId], references: [id])
  clientProfileId   String
  clientProfile     ClientProfile @relation(fields: [clientProfileId], references: [id])
  status            CutStatus     @default(IN_PROGRESS)
  chips             Json?
  startedAt         DateTime      @default(now())
  finishedAt        DateTime?
  rapidClosure      Boolean       @default(false)
  photos            CutPhoto[]
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([barberId, status])
  @@index([clientProfileId])
  @@index([startedAt])
}

model CutPhoto {
  id          String   @id @default(uuid())
  cutId       String
  cut         Cut      @relation(fields: [cutId], references: [id], onDelete: Cascade)
  r2Key       String   @unique
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([cutId])
}
